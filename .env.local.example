# Mail-Versand für das Kontaktformular (/api/inquiry)
# Datei nach .env.local kopieren und Werte eintragen — .env.local wird nicht committet.

# ── Variante A: Gmail SMTP mit dem bestehenden Google-Konto (empfohlen) ──
# Voraussetzung: Beim Konto info@flatties.ch die 2-Faktor-Authentifizierung
# aktivieren, dann unter https://myaccount.google.com/apppasswords ein
# App-Passwort ("Mail") erzeugen und hier eintragen.
SMTP_USER=info@flatties.ch
SMTP_PASS=xxxx xxxx xxxx xxxx
# Optional (Standardwerte passen für Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
MAIL_FROM="Flatties Website <info@flatties.ch>"

# ── Variante B: Resend als Alternative (nur falls gewünscht) ──
# RESEND_API_KEY=re_...

# ── Google Reviews auf der Website ──
# API-Key aus der Google Cloud Console (gleiches Google-Konto, kein neuer Dienst):
# 1. https://console.cloud.google.com → Projekt anlegen (z. B. "flatties-website")
# 2. "Places API (New)" aktivieren
# 3. API-Schlüssel erstellen (am besten auf Places API beschränken)
GOOGLE_MAPS_API_KEY=
# Optional: feste Place-ID statt Suche nach "Flatties Smashburger St. Gallen"
# GOOGLE_PLACE_ID=

# Google Maps Einbettung im Standort-Block (öffentlicher Key!)
# Separaten Key erstellen, eingeschränkt auf "Maps Embed API" + eure Domain.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
